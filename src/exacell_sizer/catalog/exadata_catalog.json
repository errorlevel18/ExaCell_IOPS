    "sql_read_iops_8k": {"unit": "IOPS", "label": "Maximum SQL Read IOPS", "conditions": "Based on 8K I/O requests running SQL. El nivel que sirve las lecturas (flash, PMEM o XRMEM) depende del modelo: ver 'read_iops_tier'.", "direction": "read", "layer": "model_tier", "io": "8k"},
    "sql_flash_write_iops_8k": {"unit": "IOPS", "label": "Maximum SQL Write IOPS / Flash Write IOPS", "conditions": "Based on 8K I/O requests running SQL. Flash write I/Os measured at the storage servers after ASM mirroring.", "direction": "write", "layer": "flash", "io": "8k"},
    "sql_disk_bandwidth": {"unit": "GB/s", "label": "Maximum SQL Disk Bandwidth (rack)", "conditions": "Peak physical scan bandwidth achieved running SQL, assuming no database compression. Publicado solo por rack.", "direction": "read", "layer": "hdd", "io": "scan"},
    "sql_disk_iops": {"unit": "IOPS", "label": "Maximum SQL Disk IOPS (rack)", "conditions": "Based on 8K IO requests running SQL. Publicado solo por rack; la mezcla lectura/escritura no se especifica.", "direction": "unspecified", "layer": "hdd", "io": "8k"},
    "db_sql_read_iops_8k": {"unit": "IOPS", "label": "Database Server Maximum SQL Read IOPS", "conditions": "Based on 8K I/O requests running SQL (servidor de base de datos).", "direction": "read", "layer": "db_server", "io": "8k"},
    "db_sql_write_iops_8k": {"unit": "IOPS", "label": "Database Server Maximum SQL Write IOPS", "conditions": "Based on 8K I/O requests running SQL (servidor de base de datos).", "direction": "write", "layer": "db_server", "io": "8k"}
