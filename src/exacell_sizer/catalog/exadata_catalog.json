    "sql_flash_scan_bandwidth": {"unit": "GB/s", "label": "Maximum SQL Flash Bandwidth", "conditions": "Peak physical scan bandwidth achieved running SQL, assuming no database compression (lectura de escaneo).", "direction": "read", "layer": "flash", "io": "scan"},
